<!-- پیغام Toast کپی سریع -->
<div id="toast">شماره کپی شد! 📋</div>

<script>
    function switchTab(tabId) {
        document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
        
        document.getElementById(tabId).classList.add('active');
        document.getElementById('btn-tab-' + tabId).classList.add('active');
    }

    let installments = JSON.parse(localStorage.getItem('my_installments_v3')) || [];
    let notes = JSON.parse(localStorage.getItem('my_notes_v3')) || [];
    let currentInstFilter = 'all';

    function showToast(msg) {
        const toast = document.getElementById('toast');
        toast.innerText = msg;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2000);
    }

    function copyToClipboard(text, e) {
        if (e) e.stopPropagation();
        if (!text || text === '-') {
            showToast('شماره کارتی ثبت نشده است');
            return;
        }
        const cleanText = text.replace(/[\s-]/g, '');
        
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(cleanText).then(() => {
                showToast('شماره کارت کپی شد! 📋');
            }).catch(() => {
                fallbackCopy(cleanText);
            });
        } else {
            fallbackCopy(cleanText);
        }
    }

    function fallbackCopy(text) {
        const textArea = document.createElement("textarea");
        textArea.value = text;
        document.body.appendChild(textArea);
        textArea.select();
        document.execCommand("copy");
        document.body.removeChild(textArea);
        showToast('شماره کارت کپی شد! 📋');
    }

    document.getElementById('installment-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const amountVal = parseFloat(document.getElementById('inst-amount').value) || 0;
        
        const newInst = {
            id: Date.now(),
            title: document.getElementById('inst-title').value.trim(),
            amount: amountVal,
            card: document.getElementById('inst-card').value.trim() || '-',
            date: document.getElementById('inst-date').value.trim() || '-',
            desc: document.getElementById('inst-desc').value.trim() || '-',
            isPaid: false
        };

        installments.push(newInst);
        saveInstallments();
        renderInstallments();
        this.reset();
        showToast('قسط جدید با موفقیت ثبت شد ✅');
    });

    function saveInstallments() {
        localStorage.setItem('my_installments_v3', JSON.stringify(installments));
        updateStats();
    }

    function togglePaidStatus(id, e) {
        if (e) e.stopPropagation();
        const inst = installments.find(item => item.id === id);
        if (inst) {
            inst.isPaid = !inst.isPaid;
            saveInstallments();
            renderInstallments();
        }
    }

    function setInstFilter(filter, btn) {
        currentInstFilter = filter;
        document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        renderInstallments();
    }

    function updateStats() {
        let total = 0;
        let paid = 0;

        installments.forEach(item => {
            const amt = parseFloat(item.amount) || 0;
            total += amt;
            if (item.isPaid) paid += amt;
        });

        const remaining = total - paid;

        document.getElementById('stat-total').innerText = total.toLocaleString('fa-IR');
        document.getElementById('stat-paid').innerText = paid.toLocaleString('fa-IR');
        document.getElementById('stat-remaining').innerText = remaining.toLocaleString('fa-IR');
    }

    function renderInstallments() {
        const list = document.getElementById('installment-list');
        list.innerHTML = '';

        let filtered = installments;
        if (currentInstFilter === 'paid') {
            filtered = installments.filter(item => item.isPaid);
        } else if (currentInstFilter === 'unpaid') {
            filtered = installments.filter(item => !item.isPaid);
        }

        if (filtered.length === 0) {
            list.innerHTML = '<div class="empty-state">هیچ قسطی در این بخش ثبت نشده است.</div>';
            return;
        }

        filtered.forEach((item, index) => {
            const isPaid = item.isPaid;
            const amountFormatted = Number(item.amount).toLocaleString('fa-IR');

            const itemEl = document.createElement('div');
            itemEl.className = `inst-item ${isPaid ? 'paid' : ''}`;

            itemEl.innerHTML = `
                <div class="inst-top">
                    <div class="inst-title-area">
                        <span class="drag-handle">⣿</span>
                        <span class="inst-title">${item.title}</span>
                    </div>
                    <div class="inst-amount-tag">${amountFormatted} م‌ت</div>
                </div>

                <div class="inst-details-grid">
                    <div class="detail-row">
                        <span>💳</span>
                        <span>کارت/شبا:</span>
                        <span class="copy-box" onclick="copyToClipboard('${item.card}', event)" title="کلیک برای کپی">
                            ${item.card} <span class="copy-icon">📋</span>
                        </span>
                    </div>
                    <div class="detail-row">
                        <span>📅</span>
                        <span>موعد:</span>
                        <strong>${item.date}</strong>
                    </div>
                    ${item.desc !== '-' ? `<div class="detail-row" style="grid-column: 1/-1;"><span>💬</span> <span>${item.desc}</span></div>` : ''}
                </div>

                <div class="inst-actions">
                    <button class="status-badge ${isPaid ? 'paid' : 'unpaid'}" onclick="togglePaidStatus(${item.id}, event)">
                        ${isPaid ? '✅ پرداخت شده' : '⏳ پرداخت نشده'}
                    </button>
                    
                    <div class="action-btns">
                        <button class="btn-icon" title="جابجایی به بالا" onclick="moveItem(${index}, -1, event)">⬆</button>
                        <button class="btn-icon" title="جابجایی به پایین" onclick="moveItem(${index}, 1, event)">⬇</button>
                        <button class="btn-icon delete" title="حذف" onclick="deleteInstallment(${item.id}, event)">🗑️</button>
                    </div>
                </div>
            `;

            list.appendChild(itemEl);
        });
    }

    function moveItem(index, direction, e) {
        if (e) e.stopPropagation();
        const targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= installments.length) return;

        const temp = installments[index];
        installments[index] = installments[targetIndex];
        installments[targetIndex] = temp;

        saveInstallments();
        renderInstallments();
    }

    function deleteInstallment(id, e) {
        if (e) e.stopPropagation();
        if (confirm('آیا از حذف این قسط مطمئن هستید؟')) {
            installments = installments.filter(item => item.id !== id);
            saveInstallments();
            renderInstallments();
        }
    }

    document.getElementById('note-form').addEventListener('submit', function(e) {
        e.preventDefault();
        const newNote = {
            id: Date.now(),
            title: document.getElementById('note-title').value.trim(),
            date: document.getElementById('note-date').value.trim(),
            desc: document.getElementById('note-desc').value.trim()
        };

        notes.unshift(newNote);
        saveNotes();
        renderNotes();
        this.reset();
        showToast('یادداشت جدید ثبت شد 📝');
    });

    function saveNotes() {
        localStorage.setItem('my_notes_v3', JSON.stringify(notes));
    }

    function renderNotes() {
        const container = document.getElementById('notes-container');
        const query = (document.getElementById('note-search')?.value || '').toLowerCase();
        container.innerHTML = '';

        const filtered = notes.filter(item => 
            item.title.toLowerCase().includes(query) || 
            item.desc.toLowerCase().includes(query)
        );

        if (filtered.length === 0) {
            container.innerHTML = '<div class="empty-state" style="grid-column: 1/-1;">هیچ یادداشتی یافت نشد.</div>';
            return;
        }

        filtered.forEach((item) => {
            const card = document.createElement('div');
            card.className = 'note-card';
            card.innerHTML = `
                <div>
                    <div class="note-header">
                        <div class="note-title-area">
                            <span class="drag-handle">⣿</span>
                            <div class="note-title">${item.title}</div>
                        </div>
                        <div class="note-date">📅 ${item.date}</div>
                    </div>
                    <div class="note-body">${item.desc}</div>
                </div>
                <div class="note-footer">
                    <div class="action-btns">
                        <button class="btn-icon" title="جابجایی به بالا" onclick="moveNote(${item.id}, -1, event)">⬆</button>
                        <button class="btn-icon" title="جابجایی به پایین" onclick="moveNote(${item.id}, 1, event)">⬇</button>
                    </div>
                    <button class="btn-icon delete" title="حذف" onclick="deleteNote(${item.id}, event)">حذف 🗑️</button>
                </div>
            `;
            container.appendChild(card);
        });
    }

    function moveNote(id, direction, e) {
        if (e) e.stopPropagation();
        const index = notes.findIndex(n => n.id === id);
        if (index === -1) return;

        const targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= notes.length) return;

        const temp = notes[index];
        notes[index] = notes[targetIndex];
        notes[targetIndex] = temp;

        saveNotes();
        renderNotes();
    }

    function deleteNote(id, e) {
        if (e) e.stopPropagation();
        if (confirm('آیا از حذف این یادداشت مطمئن هستید؟')) {
            notes = notes.filter(item => item.id !== id);
            saveNotes();
            renderNotes();
        }
    }

    function exportData() {
        const data = {
            installments: installments,
            notes: notes,
            exportDate: new Date().toLocaleDateString('fa-IR')
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `backup-installments-notes-${Date.now()}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast('فایل پشتیبان دانلود شد 💾');
    }

    function importData(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const imported = JSON.parse(e.target.result);
                if (imported.installments || imported.notes) {
                    installments = imported.installments || [];
                    notes = imported.notes || [];
                    saveInstallments();
                    saveNotes();
                    renderInstallments();
                    renderNotes();
                    showToast('اطلاعات بازیابی شد ✅');
                } else {
                    alert('فرمت فایل معتبر نیست.');
                }
            } catch (err) {
                alert('خطا در خواندن فایل.');
            }
        };
        reader.readAsText(file);
    }

    renderInstallments();
    renderNotes();
</script>

</body>
</html>
